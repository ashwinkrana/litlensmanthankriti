# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored. NEVER commit real keys (SECURITY.md S-1..S-6).

# --- LLM keys (backend only, never put these in VITE_* variables) ---
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=
# Current Gemini Flash model ID from Google AI Studio. No default on purpose.
GEMINI_MODEL=

# --- Models (DESIGN §5) ---
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_SMART_MODEL=openai/gpt-oss-120b

# --- Groq free-tier limits per model (DESIGN §5, SRS C1) ---
GROQ_TPM=8000
GROQ_RPM=30

# --- LLM call options ---
# gpt-oss reasoning tokens count toward TPM: keep this low
GROQ_REASONING_EFFORT=low
# Optional. Allowed values depend on the Gemini model (check its docs), e.g. low
GEMINI_THINKING_LEVEL=
LLM_TIMEOUT_S=60
# Test switch (ENV=dev only): make every Groq call fail with 429 so the
# Gemini fallback is used. Keep false for normal use and for the demo.
DEBUG_FORCE_GROQ_429=false

# --- Server ---
# dev enables /docs; use prod for the demo (SECURITY N-3)
ENV=dev
# 127.0.0.1 only. 0.0.0.0 exposes the API to the network (SECURITY N-1).
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (relative paths are resolved from the repo root) ---
DATA_DIR=data

# --- Behaviour ---
DEMO_MODE=false
SUPPORT_THRESHOLD=0.35
LOG_LEVEL=INFO

# --- arXiv politeness: contact for the User-Agent (SECURITY D-6) ---
ARXIV_CONTACT=your-email@example.com
